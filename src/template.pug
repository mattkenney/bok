doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport")
    title= 'Book Marks Fiction Reviews'
    meta(content="yes" name="apple-mobile-web-app-capable")
    meta(content="yes" name="mobile-web-app-capable")
    link(href="/css/pico.min.css" rel="stylesheet")
    style.
      .tag {
        background-color: #ccc;
        border-radius: 12px;
        color: #333;
        display: inline-block;
        font-size: 90%;
        margin: 3px;
        padding: 1px 9px 3px 9px;
      }
      details summary {
        border-top: 1px solid #ccc;
        padding-top: 2ex;
      }
  body
    main(class="container")
      h3= `Book Marks Fiction Reviews ${offset + 1} - ${next}`
      each item, index in data
        details(id='i' + (index + 1))
          summary
            i= item.book_name
            span!= ' &#8226; '
            span= item.book_author
            span!= ' &#8226; '
            span(class="tag")
              span(style="color:green")!= '&#x25B2;'.repeat(item.raves)
              span(style="color:blue")!= '&#x25B4;'.repeat(item.good)
              span(style="color:yellow")!= '&#x25C6;'.repeat(item.mixed)
              span(style="color:red")!= '&#x25BC;'.repeat(item.pan)
            each cat in item.post_category
              unless cat.name === "Fiction" || cat.name === "Literary"
                span(class="tag")!= cat.name
          article
            div!= item.book_manual_description
            div
              a(href=item.url)= 'Reviews'
      if offset > 0
        a(href=`?offset=${Math.max(0, offset - data.length)}`)= 'Previous'
        span!= ' &#8226; '
      a(href=`?offset=${next}`)= 'Next'
