doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(content="width=device-width, initial-scale=1" name="viewport")
    title= 'Reviews'
    meta(content="yes" name="apple-mobile-web-app-capable")
    meta(content="yes" name="mobile-web-app-capable")
    link(href="/favicon.ico" rel="icon" sizes="32x32")
    link(href="/icon/fav.svg" rel="icon" type="image/svg+xml")
    link(href="/icon/180.png" rel="apple-touch-icon")
    link(href="/css/pico.min.css" rel="stylesheet")
    link(href="/manifest.json" rel="manifest")
    style.
      .tag {
        background-color: #ccc;
        border-radius: 12px;
        color: #333;
        display: inline-block;
        font-size: 90%;
        margin: 3px;
        padding: 1px 9px 3px 9px;
      }
      details summary {
        border-top: 1px solid #ccc;
        padding-top: 2ex;
      }
  body
    main(class="container")
      h3!= `Book Marks &#8226; Fiction &#8226; ${offset + 1} - ${next}`
      each item, index in items
        details(id='i' + (offset + index + 1))
          summary
            i= item.book_name
            span!= ' &#8226; '
            span= item.book_author
            span!= ' &#8226; '
            span(class="tag")
              span(style="color:#0b5")!= '&#x25b2;'.repeat(item.raves)
              span(style="color:#33f")!= '&#x25b4;'.repeat(item.good)
              span(style="color:#ff3")!= '&#x25c6;'.repeat(item.mixed)
              span(style="color:#f33")!= '&#x25bc;'.repeat(item.pan)
            each cat in item.post_category
              unless cat.name === "Fiction" || cat.name === "Literary"
                span(class="tag")!= cat.name
          article
            div!= item.book_manual_description
            div
              a(href=item.url)= 'Reviews'
      if offset > 0
        a(href=`?offset=${Math.max(0, offset - items.length)}`)= 'Previous'
        span!= ' &#8226; '
      a(href=`?offset=${next}`)= 'Next'
